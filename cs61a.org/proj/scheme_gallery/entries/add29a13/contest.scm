(define (draw)
  (bgcolor "white")
  (draw-grid campanile))

(define (draw-square c px)
  (color c)
  (begin_fill)
  (pd)
  (forward px) (right 90)
  (forward px) (right 90)
  (forward px) (right 90)
  (forward px) (right 90)
  (end_fill)
  (pu))

(define (draw-grid grid)
  (penup)
  (setheading 0)

  (define H (length grid))
  (define W (length (car grid)))
  (define sw (screen_width))
  (define sh (screen_height))

  ;; compute size
  (define px-w (quotient sw W))
  (define px-h (quotient sh H))
  (define px (if (< px-w px-h) px-w px-h))
  (define px (if (= px 0) 1 px))

  ;; compute origin
  (define gridW (* W px))
  (define gridH (* H px))
  (define offsetX (/ (- gridW) 2))
  (define offsetY (- (/ gridH 2) px))

  ;; draw one row
  (define (draw-row row col row-index)
    (if (null? row)
        'done
        (begin
          (setposition (+ offsetX (* col px))
                       (- offsetY (* row-index px)))
          (draw-square (car row) px)
          (draw-row (cdr row) (+ col 1) row-index))))

  ;; draw full grid
  (define (draw-rows rows row-index)
    (if (null? rows)
        'done
        (begin
          (draw-row (car rows) 0 row-index)
          (draw-rows (cdr rows) (+ row-index 1)))))

  (draw-rows grid 0)
  (hideturtle))

; Please leave this last line alone. You may add additional procedures above
; this line.
(draw)