(define (draw)
  ; YOUR CODE HERE
  (define image-rows (list                                                                                                                                                                       ))

  (define (draw-board list sx sy size)
    (define (draw-pixel-num pixels x y)
      (if (eq? pixels 0)
          '()
          (begin
            (display (modulo pixels 1000000000))
            (draw-pixel x y (modulo pixels 1000000000) size)
            (draw-pixel-num (quotient pixels 1000000000) (+ x size) y)))) 

    (define (draw-row rows y)
      (if (null? rows)
          '() 
          (begin
            (draw-pixel-num (car rows) sx y)
            (draw-row (cdr rows) (+ y size)))))

  (define (draw-pixel-row x y color width)
    (if (> width 0)
        (begin
          (define blue (modulo color 1000))
          (define green (modulo (quotient color 1000) 1000))
          (define red (modulo (quotient color 1000000) 1000))
          (pixel x y (rgb (/ red 255) (/ green 255) (/ blue 255)))
          (draw-pixel-row (+ x 1) y color (- width 1)))))

  (define (draw-pixel x y color size)
    (define (draw-square x y color size current-size)
      (if (> current-size 0)
          (begin
            (draw-pixel-row x y color size)
            (draw-square x (+ y 1) color size (- current-size 1)))))
    (draw-square x y color size size))

    (draw-row list sy))

    (penup)
    (draw-board image-rows -512 -512 5)
    (hideturtle)

  (exitonclick))

; Please leave this last line alone. You may add additional procedures above
; this line.
(draw)