(define (draw-leaf r x y c h)
  (color c)
  (pu)
  (goto x y)
  (seth h)
  (begin_fill)
  (pd)
  (circle r 70)
  (lt 110)
  (circle r 70)
  (end_fill)
)

(define (draw-maple-leaf r x y c h)
  (color c)
  (pu)
  (goto x y)
  (goto (+ r x) (+ (* -3 r) y))
  (seth h)
  (begin_fill)
  (pd)
  (goto (+ (* 5 r) x) (+ (* -4 r) y))
  (goto (+ (* 4 r) x) (+ y (* -3 r)))
  (goto (+ (* 9 r) x) (+ y (* 1 r)))
  (goto (+ (* 7 r) x) (+ y (* 2 r)))
  (goto (+ (* 8 r) x) (+ y (* 5 r)))
  (goto (+ (* 5 r) x) (+ y (* 4 r)))
  (goto (+ (* 5 r) x) (+ y (* 5 r)))
  (goto (+ (* 3 r) x) (+ y (* 4 r)))
  (goto (+ (* 4 r) x) (+ y (* 9 r)))
  (goto (+ (* 2 r) x) (+ y (* 7 r)))
  (goto (+ (* 0 r) x) (+ y (* 10 r)))
  (goto (+ x (* -2 r)) (+ y (* 7 r)))
  (goto (+ x (* -4 r)) (+ y (* 8 r)))
  (goto (+ x (* -3 r)) (+ y (* 3 r)))
  (goto (+ x (* -5 r)) (+ y (* 6 r)))
  (goto (+ x (* -5 r)) (+ y (* 4 r)))
  (goto (+ x (* -8 r)) (+ y (* 5 r)))
  (goto (+ x (* -7 r)) (+ y (* 2 r)))
  (goto (+ x (* -9 r)) (+ y (* 1 r)))
  (goto (+ x (* -4 r)) (+ y (* -3 r)))
  (goto (+ x (* -5 r)) (+ y (* -4 r)))
  (goto (+ x (* 0 r)) (+ y (* -3 r)))
  (goto (+ x (* 2 r)) (+ y (* -7 r)))
  (goto (+ x (* 2 r)) (+ y (* -6 r)))
  (goto (+ x (* 1 r)) (+ y (* -3 r)))
  ; (goto (+ x (* 5 r)) (+ y (* -4 r)))
  (pu)
  (end_fill)
)

