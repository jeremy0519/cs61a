(define encoded_img
  '(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
  )
)

(define (get_num_length n)
  (define (helper n length)
    (if (and (= n 0))
      length
      (helper (quotient n 10) (+ length 1))
    )
  )
  (helper n 0)
)

(define (get_up_to_next_n_nums num n)
  (define (helper num digits numlist)
    (if (or (= digits n) (zero? num))
      numlist
      (helper (quotient num 10) (+ digits 1) (append numlist (list (remainder num 10))))
    )
  )
  (helper num 0 nil)
)

(define (reverse_list numlist)
  (define (helper numlist reversed_numlist)
    (if (null? numlist)
      reversed_numlist
      (helper (cdr numlist) (append (list (car numlist)) reversed_numlist))
    )
  )
  (helper numlist nil)
)

(define (get_ordered_next_n_nums num n)
  (reverse_list (get_up_to_next_n_nums num n))
)

(define (get_next_7_nums_from_list numlist)
  (define (helper numlist digits_left)
    (define try_for_rest (get_ordered_next_n_nums (car numlist) digits_left))
    (define digits_to_go (- digits_left (length try_for_rest)))
    (if (= digits_to_go 0)
      try_for_rest
      (append try_for_rest (helper (cdr numlist) digits_to_go))
    )
  )
  (helper (reverse_list numlist) 7)
)

(define (move_n_elements_forward num n) 
  (if (= n 0)
    num ;this is zero when list gets emptied which is a problem
    (move_n_elements_forward (quotient num 10) (- n 1))
  )
)

(define (get_list_past_seven_nums numlist)
  (define (helper numlist digits_left)
    (define try_for_rest (get_up_to_next_n_nums (car numlist) digits_left))
    (define digits_to_go (- digits_left (length try_for_rest)))
    (if (= digits_to_go 0)
      (begin 
        (define remaining_num (move_n_elements_forward (car numlist) digits_left))
        (if (= remaining_num 0)
          (cdr numlist)
          (append (cdr numlist) (list remaining_num))
        )
      )
      (helper (cdr numlist) digits_to_go)
    )
  )
  (helper (reverse_list numlist) 7)
)

(define (create_three_digit_num numlist)=
  (+ (* (car numlist) 100) (* (car (cdr numlist)) 10) (car (cdr (cdr numlist)))) 
)

(define x-offset 85) 
(define y-offset 150) 

(define (draw_all_pixels rest_of_img) 
  (if (and (not (null? rest_of_img)) (not (and (= (length rest_of_img) 1) (< (car rest_of_img) 1000000))))
    (begin 
      (define next_seven_nums (get_next_7_nums_from_list rest_of_img))
      (define rest_of_img (get_list_past_seven_nums rest_of_img))

      
      (define color (car next_seven_nums))
      (define next_seven_nums (cdr next_seven_nums))

      (define x (create_three_digit_num next_seven_nums))
      (define next_seven_nums (cdr (cdr (cdr next_seven_nums))))
      
      (define y (create_three_digit_num next_seven_nums))
      (print 'Progress y)

      (if (= color 1)
        (pixel (- x x-offset) (- y y-offset) "black")
        (pixel (- x x-offset) (- y y-offset) "white")
      )
      (draw_all_pixels rest_of_img)
    )
  )
)

(define (draw)
  (pixelsize 1)
  (draw_all_pixels encoded_img)
  (ht)
  (exitonclick)
)


